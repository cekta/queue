{
  "name": "cekta/queue",
  "description": "Queue abstraction",
  "type": "library",
  "license": "GPL-3.0-only",
  "prefer-stable": true,
  "require": {
    "php": ">=8.2"
  },
  "require-dev": {
    "phpstan/phpstan": "@stable",
    "squizlabs/php_codesniffer": "@stable",
    "testo/testo": "^0.10.8"
  },
  "scripts": {
    "test": [
      "@composer install",
      "@phpcs",
      "@phpstan",
      "@testo"
    ],
    "phpcs": "./vendor/bin/phpcs",
    "phpstan": "./vendor/bin/phpstan analyse --memory-limit=-1",
    "testo": "./vendor/bin/testo"
  },
  "autoload": {
    "psr-4": {
      "Cekta\\Queue\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Cekta\\Queue\\Test\\": "tests/"
    }
  },
  "authors": [
    {
      "name": "Evgeniy Kuvshinov",
      "email": "smpl@itmywork.com"
    }
  ]
}
